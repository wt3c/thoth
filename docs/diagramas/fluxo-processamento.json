{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "Thoth — fluxo do áudio até a partitura",
    "output": "fluxo-processamento.html",
    "viewBox": [1080, 620],
    "animation": "trace",
    "quality_profile": "showcase",
    "views": [
      {"id": "entrada", "label": "1. Entrada", "focus": ["fonte", "wav"], "note": "O áudio local ou do YouTube vira um WAV normalizado e identificável."},
      {"id": "modelos", "label": "2. Modelos", "focus": ["demucs", "muscriptor"], "note": "Demucs isola o instrumento; MuScriptor converte o stem em eventos de nota."},
      {"id": "regras", "label": "3. Regras musicais", "focus": ["muscriptor", "regras", "notas"], "note": "Tempo, ritmo, rótulos e digitação transformam previsões em música editável."},
      {"id": "saida", "label": "4. Saídas", "focus": ["notas", "partitura", "audio"], "note": "O resultado preserva partitura, áudio e diagnósticos locais."}
    ]
  },
  "stages": [
    {"label": "Fonte"},
    {"label": "Preparação"},
    {"label": "Interpretação"},
    {"label": "Modelagem musical"},
    {"label": "Entrega"}
  ],
  "nodes": [
    {"id": "fonte", "type": "external", "label": "Áudio de entrada", "sublabel": "arquivo ou URL", "stage": 0, "row": 1, "tag": "ref"},
    {"id": "wav", "type": "database", "label": "Mix normalizada", "sublabel": "WAV 44,1 kHz estéreo", "stage": 1, "row": 0, "tag": "cache"},
    {"id": "demucs", "type": "backend", "label": "Demucs", "sublabel": "separa o stem alvo", "stage": 1, "row": 2, "tag": "CPU"},
    {"id": "muscriptor", "type": "backend", "label": "MuScriptor", "sublabel": "eventos de nota", "stage": 2, "row": 2, "tag": "CPU"},
    {"id": "regras", "type": "backend", "label": "Regras musicais", "sublabel": "ritmo · Viterbi", "stage": 3, "row": 1, "tag": "domínio"},
    {"id": "notas", "type": "database", "label": "Notas tratadas", "sublabel": "JSONL + diagnósticos", "stage": 3, "row": 3, "tag": "cache"},
    {"id": "partitura", "type": "frontend", "label": "Partituras", "sublabel": "GP5 + MusicXML", "stage": 4, "row": 0, "tag": "editável"},
    {"id": "audio", "type": "frontend", "label": "Áudios de estudo", "sublabel": "mix · stem · playback", "stage": 4, "row": 2, "tag": "WAV"},
    {"id": "relatorio", "type": "frontend", "label": "Relatório", "sublabel": "descartes e avisos", "stage": 4, "row": 3, "tag": "observável"}
  ],
  "flows": [
    {"id": "entrada-wav", "from": "fonte", "to": "wav", "label": "bytes de áudio", "classification": "entrada", "variant": "emphasis"},
    {"id": "wav-demucs", "from": "wav", "to": "demucs", "label": "mix", "classification": "WAV", "variant": "default", "labelAt": [315, 200]},
    {"id": "demucs-muscriptor", "from": "demucs", "to": "muscriptor", "label": "stem inteiro", "classification": "WAV", "variant": "emphasis", "route": "straight"},
    {"id": "wav-regras", "from": "wav", "to": "regras", "label": "andamento", "classification": "BPM", "variant": "dashed"},
    {"id": "muscriptor-regras", "from": "muscriptor", "to": "regras", "label": "pitch · tempo · rótulo", "classification": "NoteEvent", "variant": "emphasis"},
    {"id": "regras-notas", "from": "regras", "to": "notas", "label": "aceitas", "classification": "TabNote", "variant": "default", "labelAt": [745, 314]},
    {"id": "regras-partitura", "from": "regras", "to": "partitura", "label": "ritmo + posições", "classification": "música", "variant": "emphasis"},
    {"id": "notas-relatorio", "from": "notas", "to": "relatorio", "label": "contagens", "classification": "diagnóstico", "variant": "dashed"},
    {"id": "regras-audio", "from": "regras", "to": "audio", "label": "mix · stems · auralização", "classification": "WAV", "variant": "dashed"}
  ]
}
