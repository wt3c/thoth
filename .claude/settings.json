{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv sync)",
      "Bash(uv add:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv run thoth:*)",
      "Bash(uv run python:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(ffprobe:*)",
      "Bash(yt-dlp --version)"
    ],
    "deny": [
      "Read(./audio/**)",
      "Bash(git push:*)"
    ]
  }
}
